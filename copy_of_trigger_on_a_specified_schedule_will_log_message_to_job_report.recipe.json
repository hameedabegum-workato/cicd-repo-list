            "label": "Send to Workato log service",
            "name": "user_logs_enabled",
            "optional": true,
            "type": "string"
          }
        ],
        "uuid": "3a1b8cc8-5230-4316-9b91-7db185b93c36"
      }
    ],
    "uuid": "3d38470e-206a-4503-8b01-1e6fd2c27132",
